# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=ppp
DB_PASSWORD=change-me
DB_DATABASE=ppp

# App
PORT=3000
HOST=0.0.0.0
BIND_HOST=false
RUN_MIGRATIONS=false
NODE_ENV=development

# Auth / cookies
JWT_SECRET=change-me-long-random
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost
ACCESS_TOKEN_MAXAGE=900000
# Idle / sliding session (ms). Default 3h — se renueva al usar la app.
REFRESH_TOKEN_MAXAGE=10800000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Public URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
AUTH_FRONT_URL=http://localhost:5173
AUTH_FRONTEND_URL=http://localhost:5173
FRONTEND_URL_NGROK=
BACKEND_URL_NGROK=

# Mercado Pago (required in production/staging)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Google Maps (domicilio por ruta WhatsApp: Geocoding + Directions)
GOOGLE_MAPS_API_KEY=

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# Factus — facturación electrónica DIAN (emisión MANUAL desde tomar pedidos)
# sandbox | production
FACTUS_ENV=sandbox
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# Opcional si hay un solo rango activo
FACTUS_NUMBERING_RANGE_ID=
# Rango nota crédito (opcional: si hay un solo rango NC, PPP lo detecta solo vía API)
FACTUS_CREDIT_NOTE_RANGE_ID=
# Municipio por defecto del adquiriente (11001 = Bogotá)
FACTUS_DEFAULT_MUNICIPALITY_CODE=11001
# Método de pago DIAN por defecto (10 = efectivo)
FACTUS_DEFAULT_PAYMENT_METHOD=10
# Impuestos ítems — restaurante Colombia (impoconsumo INC, no IVA 19%)
# Código Factus/DIAN: 04 = Impuesto Nacional al Consumo, tarifa típica 8%
FACTUS_ITEM_TAX_CODE=04
FACTUS_ITEM_TAX_RATE=8.00
FACTUS_ITEM_TAX_EXCLUDED=false
# true = precios del menú ya incluyen el impoconsumo (base = precio / 1.08)
FACTUS_PRICES_INCLUDE_TAX=true

# true = loguea payload/respuesta completa de Factus (útil en sandbox)
FACTUS_DEBUG=false
