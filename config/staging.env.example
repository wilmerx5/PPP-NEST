# Copy to .env.staging on the deployment server; fill secrets there.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL_ENABLED=true
DB_SSL_CA=
# Must match the explicitly selected staging DB; wrong or empty target prevents startup.
STAGING_EXPECTED_DB_HOST=
STAGING_EXPECTED_DB_DATABASE=
STAGING_PORT=3301
STAGING_IMAGE_TAG=candidate
RUN_MIGRATIONS=false
JWT_SECRET=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Empty means a host-only cookie for dev.prontopolloportal.com.
COOKIE_DOMAIN=
# This repository serves the API. Replace localhost with the actual test frontend when available.
FRONTEND_URL=http://localhost:5174
BACKEND_URL=https://dev.prontopolloportal.com
AUTH_FRONT_URL=http://localhost:5174
AUTH_FRONTEND_URL=http://localhost:5174/logged-in
CORS_ORIGINS=https://dev.prontopolloportal.com,http://localhost:5174
# Required by the current Google strategy even when Google login is not being tested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dev.prontopolloportal.com/api/auth/google/callback
WHATSAPP_ENABLED=false
WHATSAPP_AGENT_V1=false
WHATSAPP_STAGING_OUTBOUND_ALLOW=false
STAGING_WHATSAPP_PHONE_NUMBER_ID=
STAGING_WHATSAPP_RECIPIENTS=
WHATSAPP_ACCESS_TOKEN=
# Required before receiving Meta messages; POST webhook returns 503 while absent.
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
OPENAI_API_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
FACTUS_ENV=sandbox
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
